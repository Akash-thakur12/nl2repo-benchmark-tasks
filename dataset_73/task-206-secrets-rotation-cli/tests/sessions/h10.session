{"environments": ["dev", "staging", "prod"], "grace_seconds": 300, "op": "config"}
{"env": "dev", "id": "d", "op": "consumer", "t": 10}
{"env": "staging", "id": "s", "op": "consumer", "t": 11}
{"env": "prod", "id": "p", "op": "consumer", "t": 12}
{"op": "rotate", "t": 100}
{"consumer": "d", "op": "ack", "t": 110, "version": 2}
{"env": "staging", "ok": false, "op": "health", "t": 200}
{"op": "tick", "t": 300}
{"env": "staging", "ok": true, "op": "health", "t": 400}
{"op": "rotate", "t": 500}
{"consumer": "d", "op": "ack", "t": 510, "version": 3}
{"consumer": "s", "op": "ack", "t": 520, "version": 3}
{"consumer": "p", "op": "ack", "t": 530, "version": 3}
{"op": "tick", "t": 1500}
{"op": "end", "t": 1600}
