{"environments": ["dev", "staging", "prod"], "grace_seconds": 300, "op": "config"}
{"env": "dev", "id": "d", "op": "consumer", "t": 10}
{"env": "prod", "id": "p", "op": "consumer", "t": 12}
{"env": "staging", "ok": false, "op": "health", "t": 50}
{"op": "rotate", "t": 100}
{"consumer": "d", "op": "ack", "t": 110, "version": 2}
{"op": "tick", "t": 200}
{"env": "staging", "ok": true, "op": "health", "t": 300}
{"op": "rotate", "t": 400}
{"consumer": "d", "op": "ack", "t": 410, "version": 3}
{"consumer": "p", "op": "ack", "t": 420, "version": 3}
{"op": "tick", "t": 1400}
{"op": "end", "t": 1500}
