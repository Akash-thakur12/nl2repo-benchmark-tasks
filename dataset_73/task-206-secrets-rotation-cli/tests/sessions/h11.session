{"environments": ["prod"], "grace_seconds": 300, "op": "config"}
{"env": "prod", "id": "api", "op": "consumer", "t": 10}
{"env": "prod", "ok": false, "op": "health", "t": 50}
{"op": "rotate", "t": 100}
{"op": "tick", "t": 200}
{"env": "prod", "ok": true, "op": "health", "t": 300}
{"op": "rotate", "t": 400}
{"consumer": "api", "op": "ack", "t": 410, "version": 3}
{"op": "tick", "t": 1200}
{"op": "end", "t": 1300}
