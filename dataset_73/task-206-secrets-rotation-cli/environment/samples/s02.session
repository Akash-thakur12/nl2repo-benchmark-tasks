{"environments": ["prod"], "grace_seconds": 300, "op": "config"}
{"env": "prod", "id": "api", "op": "consumer", "t": 10}
{"env": "prod", "id": "worker", "op": "consumer", "t": 20}
{"op": "rotate", "t": 100}
{"consumer": "api", "op": "ack", "t": 110, "version": 2}
{"consumer": "worker", "op": "ack", "t": 120, "version": 2}
{"op": "tick", "t": 200}
{"op": "end", "t": 300}
